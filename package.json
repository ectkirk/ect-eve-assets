{
  "name": "ecteveassets",
  "version": "2.7.7",
  "type": "module",
  "description": "EVE Online Asset Management Desktop Application",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "author": "EC Trade <contact@edencom.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ectkirk/ect-eve-assets"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:install": "node node_modules/electron/install.js --no",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware && prettier --check .",
    "lint:fix": "oxlint --type-aware --fix && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:sde": "tsx scripts/build-sde.ts",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "net.edencom.ecteveassets",
    "productName": "ECT EVE Assets",
    "copyright": "Copyright © 2025 EC Trade (edencom.net)",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "legalTrademarks": "EC Trade - edencom.net",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": "-"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "ECTEVEAssets-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ECTEVEAssets-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "ectkirk",
      "repo": "ect-eve-assets"
    }
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "i18next": "^26.7.1",
    "jose": "^6.2.15",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "tailwind-merge": "3.7.0",
    "zod": "^4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.1",
    "eslint-plugin-security": "^4.2.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "3.9.10",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.2.0",
    "vitest": "^5.0.5"
  }
}
